{
  "manifest_version": 3,
  "name": "FloatingTranslator Browser",
  "version": "0.6.0",
  "description": "持续翻译网页、动态内容和聊天输入，以 Microsoft/Azure Translator 为主引擎；v0.6 同步提供 X浏览器/Tampermonkey UserScript 版。",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "FloatingTranslator",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/content.js",
        "content/v02-enhancements.js"
      ],
      "css": ["styles/injected.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "options_page": "options/options.html"
}
