{
  "manifest_version": 3,
  "name": "FloatingTranslator Browser",
  "version": "1.2.0",
  "description": "多引擎版：Azure 多 Key 池、百度/阿里云、智能冷却、Google Web 兜底、长网页持续翻译。",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/main.js"
  },
  "action": {
    "default_title": "FloatingTranslator",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "compat/browser-api.js",
        "shared/language-core.js",
        "content/site-exclusions.js",
        "content/site-input-profile.js",
        "content/content.js",
        "content/v02-enhancements.js",
        "content/mixed-page-guard.js",
        "content/attribute-translator.js"
      ],
      "css": ["styles/injected.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "options_page": "options/options.html"
}