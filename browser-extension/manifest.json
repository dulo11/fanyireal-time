{
  "manifest_version": 3,
  "name": "FloatingTranslator Browser",
  "version": "0.7.0",
  "description": "完整网页持续翻译：Azure 主引擎、混合语言识别、聊天输入翻译、动态页面与长网页优化。",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "FloatingTranslator",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/language-core.js",
        "content/content.js",
        "content/v02-enhancements.js"
      ],
      "css": ["styles/injected.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "options_page": "options/options.html"
}
