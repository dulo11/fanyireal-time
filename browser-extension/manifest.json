{
  "manifest_version": 3,
  "name": "FloatingTranslator Browser",
  "version": "0.8.0",
  "description": "完整网页持续翻译：Azure 主引擎、属性文字翻译、暂停续跑、精确失败重试、用量统计与自动缓存清理。",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/main.js"
  },
  "action": {
    "default_title": "FloatingTranslator",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/language-core.js",
        "content/content.js",
        "content/v02-enhancements.js",
        "content/mixed-page-guard.js",
        "content/attribute-translator.js"
      ],
      "css": ["styles/injected.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "options_page": "options/options.html"
}
