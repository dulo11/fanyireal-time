<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".FloatingTranslatorApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="浮译"
        android:roundIcon="@drawable/ic_launcher"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".HistoryActivity"
            android:exported="false" />
        <activity
            android:name=".RootCallActivity"
            android:exported="false" />
        <activity
            android:name=".AsrHotwordActivity"
            android:exported="false" />
        <activity
            android:name=".AsrPrecisionActivity"
            android:exported="false" />
        <activity
            android:name=".ModelManagerActivity"
            android:exported="false" />
        <activity
            android:name=".ApiSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ScreenTranslationActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service
            android:name=".TranslationService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />
        <service
            android:name=".RootCallTranslationService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name=".ScreenTranslationAccessibilityService"
            android:exported="true"
            android:label="浮译 · 全屏翻译"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/screen_translation_accessibility_service" />
        </service>
    </application>
</manifest>
